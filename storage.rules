rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapSuperAdmin() {
      return signedIn() && request.auth.token.email == "travis@capitallumber.co";
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn() && (
        isBootstrapSuperAdmin() ||
        userProfile().status == "approved"
      );
    }

    function isAdmin() {
      return isApproved() && (
        isBootstrapSuperAdmin() ||
        userProfile().role == "superAdmin" ||
        userProfile().role == "admin"
      );
    }

    function hasAnyPermission(permissionIds) {
      return isApproved() &&
        userProfile().permissions is list &&
        userProfile().permissions.hasAny(permissionIds);
    }

    function canManageDeliveryOrders() {
      return isAdmin() || (
        isApproved() && (
          userProfile().workView == "dispatch-ops" ||
          hasAnyPermission([
            "deliveries",
            "deliveries-add",
            "deliveries-dispatch",
            "deliveries-calendar",
            "deliveries-queue",
            "deliveries-history"
          ])
        )
      );
    }

    function isAllowedDeliveryOrderFile() {
      return request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "(image/.*|application/pdf|application/octet-stream)"
        );
    }

    match /deliveries/{deliveryId}/delivery-orders/{fileName} {
      allow read: if isApproved();
      allow create, update: if canManageDeliveryOrders() &&
        isAllowedDeliveryOrderFile();
      allow delete: if canManageDeliveryOrders();
    }

    match /supplierRuns/{supplierRunId}/items/{itemId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
