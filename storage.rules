rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapSuperAdmin() {
      return signedIn() && request.auth.token.email == "travis@capitallumber.co";
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn() && (
        isBootstrapSuperAdmin() ||
        (
          userProfile().status == "approved" &&
          userProfile().role != "supplier"
        )
      );
    }

    function isAdmin() {
      return isApproved() && (
        isBootstrapSuperAdmin() ||
        userProfile().role == "superAdmin" ||
        userProfile().role == "admin"
      );
    }

    function hasAnyPermission(permissionIds) {
      return isApproved() &&
        userProfile().permissions is list &&
        userProfile().permissions.hasAny(permissionIds);
    }

    function canManageDeliveryOrders() {
      return isAdmin() || (
        isApproved() && (
          userProfile().workView == "dispatch-ops" ||
          hasAnyPermission([
            "deliveries",
            "deliveries-add",
            "deliveries-dispatch",
            "deliveries-calendar",
            "deliveries-queue",
            "deliveries-history"
          ])
        )
      );
    }

    function canManageDispatchOrderCopies() {
      return isAdmin() || (
        isApproved() && (
          userProfile().workView == "dispatch-ops" ||
          hasAnyPermission([
            "south",
            "supplier-runs-add",
            "supplier-runs-check",
            "supplier-runs-dispatch",
            "supplier-runs-calendar",
            "south-calendar",
            "their-truck-overview",
            "their-truck-pos",
            "their-truck-calendar",
            "their-truck-history",
            "po-calendar",
            "receiving",
            "deliveries",
            "deliveries-add",
            "deliveries-dispatch",
            "deliveries-calendar",
            "deliveries-queue",
            "deliveries-history"
          ])
        )
      );
    }

    function canUseSouthPhotos() {
      return isAdmin() || hasAnyPermission([
        "south",
        "supplier-runs-check",
        "supplier-runs-dispatch",
        "supplier-runs-calendar",
        "south-calendar",
        "receiving",
        "check-in",
        "today",
        "search",
        "trace",
        "sales",
        "order-flow",
        "order-builds"
      ]);
    }

    function isAllowedDeliveryOrderFile() {
      return request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType.matches(
          "(image/.*|application/pdf|application/octet-stream)"
        );
    }

    match /deliveries/{deliveryId}/delivery-orders/{fileName} {
      allow read: if isApproved();
      allow create, update: if canManageDeliveryOrders() &&
        isAllowedDeliveryOrderFile();
      allow delete: if canManageDeliveryOrders();
    }

    match /dispatchOrderCopies/{recordType}/{recordId}/{fileName} {
      allow read: if isApproved();
      allow create, update: if canManageDispatchOrderCopies() &&
        isAllowedDeliveryOrderFile();
      allow delete: if canManageDispatchOrderCopies();
    }

    match /supplierRuns/{supplierRunId}/items/{itemId}/{fileName} {
      allow read, write: if canUseSouthPhotos();
    }
  }
}
