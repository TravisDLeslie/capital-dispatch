rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapSuperAdmin() {
      return signedIn() && request.auth.token.email == "travis@capitallumber.co";
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn() && (
        isBootstrapSuperAdmin() ||
        userProfile().status == "approved"
      );
    }

    function role() {
      return isBootstrapSuperAdmin()
        ? "superAdmin"
        : userProfile().role;
    }

    function isAdmin() {
      return isApproved() && (
        role() == "superAdmin" ||
        role() == "admin"
      );
    }

    function isSuperAdmin() {
      return isApproved() && role() == "superAdmin";
    }

    function hasAnyPermission(permissionIds) {
      return isApproved() &&
        userProfile().permissions is list &&
        userProfile().permissions.hasAny(permissionIds);
    }

    function isReceiving() {
      return isApproved() && (
        isAdmin() ||
        hasAnyPermission([
          "receiving",
          "check-in",
          "today",
          "search",
          "trace",
          "yard-tasks"
        ])
      );
    }

    function canAccessYardTasks() {
      return isAdmin() || hasAnyPermission(["yard-tasks"]);
    }

    function isAssignedYardTaskUser() {
      return isApproved() &&
        (
          resource.data.assignedTo == userProfile().driverName ||
          resource.data.assignedTo == userProfile().displayName ||
          resource.data.assignedTo == request.auth.token.name
        );
    }

    function isYardTaskCompletionOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "completedAt",
        "completedById",
        "completedByName",
        "completedByEmail",
        "updatedAt"
      ]);
    }

    function isSouth() {
      return isApproved() && (
        isAdmin() ||
        hasAnyPermission([
          "south",
          "south-overview",
          "supplier-runs-add",
          "their-truck-overview",
          "their-truck-pos",
          "supplier-runs-dispatch",
          "supplier-runs-check",
          "supplier-runs-calendar",
          "south-calendar",
          "their-truck-calendar",
          "po-calendar",
          "their-truck-history",
          "supplier-runs-history"
        ])
      );
    }

    function canCreateSouthRun() {
      return isAdmin() ||
        hasAnyPermission([
          "supplier-runs-add",
          "supplier-runs-dispatch"
        ]);
    }

    function canDispatchSouthRun() {
      return isAdmin() || hasAnyPermission(["supplier-runs-dispatch"]);
    }

    function isSouthRunCreator() {
      return isApproved() && (
        resource.data.createdById == request.auth.uid ||
        resource.data.createdByEmail == request.auth.token.email
      );
    }

    function canManageSouthRun() {
      return isAdmin() || (
        role() != "driver" &&
        isSouthRunCreator()
      );
    }

    function isSouthDispatchOnlyUpdate() {
      return canDispatchSouthRun() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "driver",
          "vehicleId",
          "vehicleTitle",
          "vehicleBadge",
          "dispatchStatus",
          "updatedAt"
        ]);
    }

    function isSouthDriverProgressUpdate() {
      return isDriverFor(resource.data.driver) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "items",
          "status",
          "updatedAt",
          "completedAt",
          "stopWorkflowVersion",
          "stopArrivedAt",
          "stopCompletedAt"
        ]);
    }

    function isDelivery() {
      return isApproved() && (
        isAdmin() ||
        hasAnyPermission([
          "deliveries",
          "deliveries-add",
          "deliveries-dispatch",
          "deliveries-calendar",
          "deliveries-queue",
          "deliveries-history"
        ])
      );
    }

    function isSales() {
      return isApproved() && (
        isAdmin() ||
        hasAnyPermission([
          "sales",
          "sales-orders",
          "order-flow",
          "customers",
          "stocking-handbook",
          "sales-tools"
        ])
      );
    }

    function isAccounting() {
      return isApproved() && (
        isAdmin() ||
        hasAnyPermission([
          "accounting",
          "payment-links",
          "customer-statements"
        ])
      );
    }

    function canAccessPodPickups() {
      return isSouth() || isReceiving() || isSales();
    }

    function canAccessOrderBuilds() {
      return isAdmin() ||
        isReceiving() ||
        hasAnyPermission(["order-builds", "order-flow"]);
    }

    function isSalesReportViewer() {
      return isAdmin() || (
        isApproved() &&
        userProfile().permissions is list &&
        userProfile().permissions.hasAny(["sales-report"])
      );
    }

    function isStockingHandbookViewer() {
      return isApproved();
    }

    function isDriverFor(driverName) {
      return isApproved() &&
        userProfile().driverName == driverName &&
        hasAnyPermission([
          "supplier-runs-check",
          "supplier-runs-calendar",
          "south-calendar",
          "deliveries-queue"
        ]);
    }

    match /users/{userId} {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        (
          (
            request.resource.data.status == "pending" &&
            request.resource.data.role == "pending"
          ) ||
          (
            isBootstrapSuperAdmin() &&
            request.resource.data.status == "approved" &&
            request.resource.data.role == "superAdmin"
          )
        );

      allow get: if signedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );

      allow list: if isSuperAdmin();

      allow update: if isSuperAdmin() ||
        (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "email",
            "displayName",
            "photoURL",
            "lastLoginAt",
            "updatedAt"
          ])
        );

      allow delete: if isSuperAdmin();
    }

    match /checkIns/{checkInId} {
      allow read, create, update, delete: if isReceiving();
    }

    match /customers/{customerId} {
      allow read: if isApproved();
      allow create, update: if isSales() || isAccounting();
      allow delete: if isAdmin();
    }

    match /customerPaymentLinks/{paymentLinkId} {
      allow read, create, update, delete: if isAccounting();
    }

    match /customerStatements/{statementId} {
      allow read, create, update, delete: if isAccounting();
    }

    match /emailList/{emailListEntryId} {
      allow read, create, update, delete: if isSales() || isAdmin();
    }

    match /appFeedback/{feedbackId} {
      allow create: if isApproved() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userEmail == request.auth.token.email;
      allow read: if isAdmin() ||
        (
          isApproved() &&
          resource.data.userId == request.auth.uid
        );
      allow update, delete: if isAdmin() ||
        (
          isApproved() &&
          resource.data.userId == request.auth.uid
        );
    }

    match /internalMessages/{messageId} {
      allow read: if isAdmin() ||
        (
          isApproved() &&
          (
            resource.data.recipientId == request.auth.uid ||
            resource.data.senderId == request.auth.uid
          )
        );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (
          isApproved() &&
          resource.data.recipientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "readAt",
            "updatedAt"
          ])
        );
    }

    match /yardTasks/{yardTaskId} {
      allow read: if canAccessYardTasks();
      allow update: if isAdmin() ||
        (
          canAccessYardTasks() &&
          isAssignedYardTaskUser() &&
          isYardTaskCompletionOnlyUpdate()
        );
      allow create, delete: if isAdmin();
    }

    match /supplierRuns/{supplierRunId} {
      allow read: if isSouth() || isReceiving() || isDriverFor(resource.data.driver);
      allow create: if canCreateSouthRun();
      allow update: if canManageSouthRun() ||
        isSouthDispatchOnlyUpdate() ||
        isSouthDriverProgressUpdate();
      allow delete: if canManageSouthRun();
    }

    match /theirTruckPOs/{theirTruckPOId} {
      allow read: if isSouth() || isReceiving();
      allow create, update, delete: if isSouth();
    }

    match /podPickups/{podPickupId} {
      allow read: if canAccessPodPickups();
      allow create, update, delete: if isSales() || isSouth();
    }

    match /salesOrders/{salesOrderId} {
      allow read: if isSales() || isReceiving() || isSouth() || isDelivery();
      allow create, update: if isSales();
      allow delete: if isAdmin();
    }

    match /orderBuilds/{orderBuildId} {
      allow read: if canAccessOrderBuilds() || isSales();
      allow create: if isSales();
      allow update: if isSales() || isReceiving();
      allow delete: if isAdmin();
    }

    match /southRouteOrders/{routeOrderId} {
      allow read: if isSouth() || isDriverFor(resource.data.driver);
      allow create: if isSouth() || isDriverFor(request.resource.data.driver);
      allow update: if isSouth() || isDriverFor(resource.data.driver);
      allow delete: if isSouth();
    }

    match /deliveries/{deliveryId} {
      allow read: if isDelivery() || isDriverFor(resource.data.driver);
      allow create, delete: if isDelivery();
      allow update: if isDelivery() || isDriverFor(resource.data.driver);
    }

    match /bouncieVehicleSettings/{vehicleSettingId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /appSettings/{settingsId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /salesMonthlyReports/{salesReportId} {
      allow read: if isSalesReportViewer();
      allow create, update, delete: if isSuperAdmin();
    }

    match /stockingHandbookItems/{stockingHandbookItemId} {
      allow read: if isStockingHandbookViewer();
      allow create, update, delete: if isAdmin();
    }

    match /itemCatalogItems/{itemCatalogItemId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }
  }
}
