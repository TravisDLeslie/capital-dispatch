rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapSuperAdmin() {
      return signedIn() && request.auth.token.email == "travis@capitallumber.co";
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn() && (
        isBootstrapSuperAdmin() ||
        (
          userProfile().status == "approved" &&
          userProfile().role != "supplier"
        )
      );
    }

    function isApprovedSupplier() {
      return signedIn() &&
        userProfile().status == "approved" &&
        userProfile().role == "supplier" &&
        userProfile().vendorId is string &&
        userProfile().vendorId.size() > 0;
    }

    function role() {
      return isBootstrapSuperAdmin()
        ? "superAdmin"
        : userProfile().role;
    }

    function isAdmin() {
      return isApproved() && (
        role() == "superAdmin" ||
        role() == "admin"
      );
    }

    function isSuperAdmin() {
      return isApproved() && role() == "superAdmin";
    }

    function hasAnyPermission(permissionIds) {
      return isApproved() &&
        userProfile().permissions is list &&
        userProfile().permissions.hasAny(permissionIds);
    }

    function canUseSupplierChatInternal() {
      return isAdmin() || hasAnyPermission(["supplier-chat"]);
    }

    function hasRecentSupplierChatVerification() {
      return signedIn() &&
        request.auth.token.auth_time != null &&
        request.time.toMillis() <
          (request.auth.token.auth_time * 1000) + (30 * 60 * 1000);
    }

    function canAccessSupplierConversation(conversationData) {
      return hasRecentSupplierChatVerification() &&
        (
          canUseSupplierChatInternal() ||
          (
            isApprovedSupplier() &&
            conversationData.supplierParticipantUids is list &&
            request.auth.uid in conversationData.supplierParticipantUids &&
            conversationData.vendorId == userProfile().vendorId
          )
        );
    }

    function supplierConversation(conversationId) {
      return get(
        /databases/$(database)/documents/supplierConversations/$(conversationId)
      ).data;
    }

    function expectedMessageSenderName() {
      return userProfile().displayName is string &&
        userProfile().displayName.size() > 0
          ? userProfile().displayName
          : request.auth.token.email;
    }

    function isReceiving() {
      return isApproved() && (
        isAdmin() ||
        hasAnyPermission([
          "receiving",
          "check-in",
          "today",
          "search",
          "trace",
          "yard-tasks"
        ])
      );
    }

    function canAccessYardTasks() {
      return isAdmin() || hasAnyPermission(["yard-tasks"]);
    }

    function canAccessDispatchOpsDeliveries() {
      return isAdmin() || (
        isApproved() && userProfile().workView == "dispatch-ops"
      );
    }

    function isAssignedYardTaskUser() {
      return isApproved() &&
        (
          resource.data.assignedTo == userProfile().driverName ||
          resource.data.assignedTo == userProfile().displayName ||
          resource.data.assignedTo == request.auth.token.name
        );
    }

    function isYardTaskCompletionOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "completedAt",
        "completedById",
        "completedByName",
        "completedByEmail",
        "updatedAt"
      ]);
    }

    function isSouth() {
      return isApproved() && (
        isAdmin() ||
        hasAnyPermission([
          "south",
          "south-overview",
          "supplier-runs-add",
          "their-truck-overview",
          "their-truck-pos",
          "supplier-runs-dispatch",
          "supplier-runs-check",
          "supplier-runs-calendar",
          "south-calendar",
          "their-truck-calendar",
          "po-calendar",
          "their-truck-history",
          "supplier-runs-history"
        ])
      );
    }

    function canCreateOrders() {
      return isApproved() && (
        isAdmin() ||
        userProfile().workView == "main" ||
        hasAnyPermission(["order-flow"])
      );
    }

    function canCreateSouthRun() {
      return isAdmin() ||
        canCreateOrders() ||
        hasAnyPermission([
          "supplier-runs-add",
          "supplier-runs-dispatch"
        ]);
    }

    function canDispatchSouthRun() {
      return isAdmin() || hasAnyPermission(["supplier-runs-dispatch"]);
    }

    function isSouthRunCreator() {
      return isApproved() && (
        resource.data.createdById == request.auth.uid ||
        resource.data.createdByEmail == request.auth.token.email
      );
    }

    function canManageSouthRun() {
      return isAdmin() || (
        role() != "driver" &&
        isSouthRunCreator()
      );
    }

    function isSouthDispatchOnlyUpdate() {
      return canDispatchSouthRun() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "driver",
          "vehicleId",
          "vehicleTitle",
          "vehicleBadge",
          "dispatchStatus",
          "updatedAt"
        ]);
    }

    function isSouthDriverProgressUpdate() {
      return isDriverFor(resource.data.driver) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "items",
          "status",
          "updatedAt",
          "completedAt",
          "stopWorkflowVersion",
          "stopArrivedAt",
          "stopCompletedAt"
        ]);
    }

    function isSouthReceivingCheckInUpdate() {
      return isReceiving() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "items",
          "status",
          "completedAt",
          "stopCompletedAt",
          "updatedAt"
        ]);
    }

    function isTheirTruckReceivingCompletionUpdate() {
      return isReceiving() &&
        request.resource.data.status == "complete" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "completedAt",
          "receivedCheckInId",
          "updatedAt"
        ]);
    }

    function isDelivery() {
      return isApproved() && (
        isAdmin() ||
        hasAnyPermission([
          "deliveries",
          "deliveries-add",
          "deliveries-dispatch",
          "deliveries-calendar",
          "deliveries-queue",
          "deliveries-history"
        ])
      );
    }

    function canManageDeliveryRoutes() {
      return isApproved() && (
        isAdmin() ||
        (
          userProfile().workView != "driver" &&
          (
            userProfile().workView == "dispatch-ops" ||
            hasAnyPermission([
              "deliveries-dispatch",
              "deliveries-route-planner"
            ])
          )
        )
      );
    }

    function isSales() {
      return isApproved() && (
        isAdmin() ||
        userProfile().workView == "main" ||
        hasAnyPermission([
          "sales",
          "sales-orders",
          "order-flow",
          "customers",
          "stocking-handbook",
          "sales-tools"
        ])
      );
    }

    function canAccessPodPickups() {
      return isSouth() || isReceiving() || isSales() ||
        hasAnyPermission(["order-builds"]);
    }

    function canAccessOrderBuilds() {
      return canCreateOrders() || hasAnyPermission(["order-builds"]);
    }

    function isSalesReportViewer() {
      return isAdmin() || (
        isApproved() &&
        userProfile().permissions is list &&
        userProfile().permissions.hasAny(["sales-report"])
      );
    }

    function isStockingHandbookViewer() {
      return isApproved();
    }

    function isDriverFor(driverName) {
      return isApproved() &&
        userProfile().driverName == driverName &&
        (
          userProfile().workView == "driver" ||
          hasAnyPermission([
            "supplier-runs-check",
            "supplier-runs-calendar",
            "south-calendar",
            "deliveries-queue",
            "deliveries-route-planner"
          ])
        );
    }

    match /users/{userId} {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        (
          (
            request.resource.data.status == "pending" &&
            request.resource.data.role == "pending"
          ) ||
          (
            isBootstrapSuperAdmin() &&
            request.resource.data.status == "approved" &&
            request.resource.data.role == "superAdmin"
          )
        );

      allow get: if signedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );

      allow list: if isSuperAdmin() || canManageDeliveryRoutes() ||
        canUseSupplierChatInternal();

      allow update: if isSuperAdmin() ||
        (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "email",
            "displayName",
            "photoURL",
            "lastLoginAt",
            "updatedAt"
          ])
        );

      allow delete: if isSuperAdmin();
    }

    match /supplierAccountDeletionRequests/{requestId} {
      allow create: if isSuperAdmin() &&
        request.resource.data.keys().hasOnly([
          "targetUserId",
          "createdBy",
          "status",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.targetUserId is string &&
        request.resource.data.targetUserId.size() > 0 &&
        request.resource.data.targetUserId != request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow read: if isSuperAdmin() &&
        resource.data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    match /supplierInvitations/{invitationId} {
      allow read: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification();
      allow create: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification() &&
        request.resource.data.keys().hasOnly([
          "email",
          "contactName",
          "vendorId",
          "vendorName",
          "status",
          "emailStatus",
          "createdAt",
          "updatedAt",
          "createdBy"
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.contactName is string &&
        request.resource.data.contactName.size() > 0 &&
        request.resource.data.contactName.size() <= 120 &&
        request.resource.data.vendorId is string &&
        request.resource.data.vendorId.size() > 0 &&
        request.resource.data.vendorName is string &&
        request.resource.data.vendorName.size() > 0 &&
        request.resource.data.status == "pending" &&
        request.resource.data.emailStatus == "queued" &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification() &&
        resource.data.status == "pending" &&
        request.resource.data.status == "canceled" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "canceledAt",
          "canceledBy",
          "updatedAt"
        ]) &&
        request.resource.data.canceledBy == request.auth.uid &&
        request.resource.data.canceledAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.vendorId == resource.data.vendorId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() && hasRecentSupplierChatVerification();
    }

    match /supplierConversations/{conversationId} {
      allow read: if canAccessSupplierConversation(resource.data);
      allow create: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification() &&
        request.resource.data.vendorId is string &&
        request.resource.data.supplierParticipantUids is list &&
        request.resource.data.internalParticipantUids is list &&
        request.resource.data.internalParticipantUids.hasAny([request.auth.uid]) &&
        request.resource.data.supplierParticipantUids.size() > 0 &&
        request.resource.data.internalParticipantUids.size() > 0;
      allow update: if (
          canUseSupplierChatInternal() &&
          hasRecentSupplierChatVerification()
        ) ||
        (
          canAccessSupplierConversation(resource.data) &&
          request.resource.data.vendorId == resource.data.vendorId &&
          request.resource.data.supplierParticipantUids == resource.data.supplierParticipantUids &&
          request.resource.data.internalParticipantUids == resource.data.internalParticipantUids &&
          request.resource.data.lastMessageBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "updatedAt",
            "lastMessage",
            "lastMessageBy"
          ]) &&
          request.resource.data.updatedAt == request.time
        );
      allow delete: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification();

      match /messages/{messageId} {
        allow read: if canAccessSupplierConversation(
          supplierConversation(conversationId)
        );
        allow create: if canAccessSupplierConversation(
            supplierConversation(conversationId)
          ) &&
          request.resource.data.keys().hasOnly([
            "type",
            "vendorId",
            "senderUid",
            "senderName",
            "senderRole",
            "text",
            "createdAt",
            "quote"
          ]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderName == expectedMessageSenderName() &&
          (
            !isApprovedSupplier() ||
            request.resource.data.senderRole == "supplier"
          ) &&
          request.resource.data.vendorId == supplierConversation(conversationId).vendorId &&
          request.resource.data.type in ["text", "quote"] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 5000 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if canUseSupplierChatInternal() &&
          hasRecentSupplierChatVerification();
      }
    }

    match /supplierQuotes/{quoteId} {
      allow read: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification();
      allow create: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification() &&
        request.resource.data.vendorId is string &&
        request.resource.data.conversationId is string &&
        request.resource.data.messageId is string &&
        request.resource.data.quote is map &&
        request.resource.data.savedBy == request.auth.uid &&
        request.resource.data.savedAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification() &&
        request.resource.data.vendorId == resource.data.vendorId &&
        request.resource.data.conversationId == resource.data.conversationId &&
        request.resource.data.messageId == resource.data.messageId &&
        request.resource.data.savedBy == request.auth.uid &&
        request.resource.data.savedAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow delete: if canUseSupplierChatInternal() &&
        hasRecentSupplierChatVerification();
    }

    match /appSettings/{settingId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /checkIns/{checkInId} {
      allow read: if isReceiving() || canAccessOrderBuilds();
      allow create, update, delete: if isReceiving();
    }

    match /yardTasks/{yardTaskId} {
      allow read: if canAccessYardTasks();
      allow update: if isAdmin() ||
        (
          canAccessYardTasks() &&
          isAssignedYardTaskUser() &&
          isYardTaskCompletionOnlyUpdate()
        );
      allow create, delete: if isAdmin();
    }

    match /dispatchOpsDailyDeliveries/{deliveryId} {
      allow read, create, update, delete: if canAccessDispatchOpsDeliveries();
    }

    match /supplierRuns/{supplierRunId} {
      allow read: if isSouth() || isReceiving() || canAccessOrderBuilds() || isDriverFor(resource.data.driver);
      allow create: if canCreateSouthRun();
      allow update: if canManageSouthRun() ||
        isSouthDispatchOnlyUpdate() ||
        isSouthReceivingCheckInUpdate() ||
        isSouthDriverProgressUpdate();
      allow delete: if canManageSouthRun();
    }

    match /theirTruckPOs/{theirTruckPOId} {
      allow read: if isSouth() || isReceiving() || canAccessOrderBuilds();
      allow create: if isSouth() || canCreateOrders();
      allow update: if isSouth() || isTheirTruckReceivingCompletionUpdate();
      allow delete: if isSouth();
    }

    match /podPickups/{podPickupId} {
      allow read: if canAccessPodPickups();
      allow create, update, delete: if isSales() || isSouth();
    }

    match /salesOrders/{salesOrderId} {
      allow read: if isSales() || isReceiving() || isSouth() || isDelivery();
      allow create, update: if isSales();
      allow delete: if isAdmin();
    }

    match /orderBuilds/{orderBuildId} {
      allow read: if canAccessOrderBuilds() || isSales();
      allow create: if isSales();
      allow update: if isSales() || hasAnyPermission(["order-builds"]);
      allow delete: if isAdmin() || hasAnyPermission(["order-builds"]);
    }

    match /southRouteOrders/{routeOrderId} {
      allow read: if isSouth() || isDriverFor(resource.data.driver);
      allow create: if isSouth() || isDriverFor(request.resource.data.driver);
      allow update: if isSouth() || isDriverFor(resource.data.driver);
      allow delete: if isSouth();
    }

    match /deliveries/{deliveryId} {
      allow read: if isDelivery() || canAccessOrderBuilds() || isDriverFor(resource.data.driver);
      allow create: if isDelivery() || canCreateOrders();
      allow delete: if isDelivery();
      allow update: if isDelivery() || isDriverFor(resource.data.driver);
    }

    match /sharedDeliveryRoutes/{routeId} {
      allow read: if canManageDeliveryRoutes() ||
        isDriverFor(resource.data.assignedDriverName);
      allow create, update, delete: if canManageDeliveryRoutes();
    }

    match /bouncieVehicleSettings/{vehicleSettingId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /salesMonthlyReports/{salesReportId} {
      allow read: if isSalesReportViewer();
      allow create, update, delete: if isSuperAdmin();
    }

    match /stockingHandbookItems/{stockingHandbookItemId} {
      allow read: if isStockingHandbookViewer();
      allow create, update, delete: if isAdmin();
    }
  }
}
